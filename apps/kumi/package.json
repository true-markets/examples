{
  "name": "kumi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "doctor": "node scripts/preflight.mjs",
    "predev": "node scripts/preflight.mjs",
    "prestart": "node scripts/preflight.mjs",
    "dev": "concurrently \"tsx watch server/index.ts\" \"vite --config web/vite.config.ts\"",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -p server && tsc -p web --noEmit",
    "test": "vitest run",
    "return-funds": "tsx scripts/return-funds.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@solana-program/system": "0.16.0",
    "@solana-program/token": "0.18.0",
    "@solana/kit": "8.6.0",
    "@tanstack/react-query": "^5.103.2",
    "hono": "^4.13.9",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
