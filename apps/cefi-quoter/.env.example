# Copy to .env and edit. Real environment variables win over this file.
# One quoter runs every book. Add books from the console's Quoter screen (or POST /api/books);
# the quoter saves them, with each book's settings, to QUOTER_BOOKS_FILE.

# --- account ---------------------------------------------------------------------------------
# With no key file, the quoter runs in paper mode: a simulated exchange priced off live
# market prices (Coinbase for crypto, Hyperliquid for tokenized stocks).
# Put the key file from app.truemarkets.co (Settings, API keys) in .secrets/ to go live.
# TM_API_KEY_PATH=.secrets
# QUOTER_MODE=            # live or paper; default: live if a key file is found
TM_ENV=uat                # uat or production. Production trades real funds.
# TM_CLIENT_ID=           # only if the token doesn't carry it
# TM_ORGANIZATION_ID=     # organization keys only

# --- books -----------------------------------------------------------------------------------
QUOTER_BOOKS_FILE=books.json # the books to quote and their settings; the quoter keeps it up to date
# QUOTER_STATE_FILE=state.production.json # position, PnL, activity and trades across restarts; one per environment by default
QUOTER_AUTOSTART=false       # false: every book waits for Start in the console (or POST /api/start)

# --- strategy: what a newly added book starts with ---------------------------------------------
# Each book then has its own copy, changed live on the Quoter screen and saved to the books file.
SIZE_UNIT=quote            # quote: the sizes below are in USDC, converted at the reference price
                           # base: they're in each book's base asset (0.001 means 0.001 BTC)
SPREAD_BPS=10              # first level's distance from the mid, each side
LEVELS=3                   # orders per side
LEVEL_SPREAD_MULT=1.5      # each level out is this many times the previous spread
QUOTE_SIZE=10              # first level's size, in SIZE_UNIT. It must cover one lot: about $6 on BTC
LEVEL_SIZE_MULT=1          # each level out is this many times the previous size
MODIFY_THRESHOLD_BPS=2     # leave an order alone until its target moves this far
MAX_POSITION=100           # max position change: how far a book may move your holdings from where they
                           # were at start (bought minus sold since), in SIZE_UNIT; 0 turns it off
SKEW_BPS=5                 # shift the mid this far toward flat at the position limit
MAX_QUOTE_ALLOC=0          # most quote this book's bids may hold; 0 = any free balance
MAX_BASE_ALLOC=0           # most base this book's asks may hold, in SIZE_UNIT; 0 = any free balance
REF_STALE_MS=3000          # leave a reference source out after this long silent; pull quotes when every source is
REF_GUARD_BPS=500          # stop quoting while the book trades this far through the reference (0 = off)
MIN_REQUOTE_MS=100         # smallest gap between rounds of order changes

# --- taking: crossing the spread with an IOC (see README, "Taking") ---------------------------
PROFIT_TAKER=true          # close inventory when the book pays enough over fair, never below cost
TAKEOUT=false              # build inventory when the book sits far past fair; opportunistic
TAKE_EDGE_BPS=25           # net edge over the skewed mid, after the taker fee, a take needs
TAKE_FLATTEN_FLOOR_BPS=2   # the least a profit take accepts, at the max position change
TAKE_MAX_SIZE=20           # largest single take, in SIZE_UNIT
TAKE_COOL_DOWN_MS=3000     # least time between two takes on a book
TAKER_FEE_BPS=0            # your taker fee; the published CeFi schedule is 0

# --- order entry -----------------------------------------------------------------------------
ORDER_TRANSPORT=rest       # rest or fix
# FIX endpoints aren't public: ask support@truemarkets.co for the address and TargetCompID.
# FIX_ADDR=host:port
# FIX_TLS=false           # the FIX endpoint is plain FIX over a private connection; true only if support says so
# FIX_SENDER_COMP_ID=      # yours to choose; a session stays bound to the key that first logs on
# FIX_TARGET_COMP_ID=
# FIX_HEARTBEAT_SECS=30
# FIX_CANCEL_ON_DISCONNECT=true

# --- management API --------------------------------------------------------------------------
ADMIN_ADDR=127.0.0.1:4860
# ADMIN_TOKEN=             # required if ADMIN_ADDR is reachable from other machines
LOG_LEVEL=info             # debug logs every drop copy and request

# --- paper mode ------------------------------------------------------------------------------
# Starting balances. Every asset other than USDC is offered as a book against USDC. Tokenized
# stocks work too (GOOGLC=2 offers GOOGLC-USDC, priced off Hyperliquid xyz:GOOGL).
PAPER_BALANCES=USDC=10000,BTC=0.05,ETH=1,SOL=20
